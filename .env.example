KESSLER_ENV=dev
KESSLER_PUBLIC_URL=http://localhost:8080

KESSLER_DATABASE_URL=postgresql://kessler:kessler@127.0.0.1:5433/kessler
KESSLER_DATABASE_REPLICA_URL=postgresql://kessler:kessler@127.0.0.1:5434/kessler
KESSLER_DB_STATEMENT_CACHE_SIZE=256
KESSLER_REDIS_URL=redis://127.0.0.1:6380/0

KESSLER_JWT_SECRET=change-me
KESSLER_STREAM_SECRET=change-me
KESSLER_COOKIE_SECURE=false

KESSLER_WORKER_THREADS=2
KESSLER_MAX_ACTIVE_ANALYSES_PER_USER=3
KESSLER_MAX_SIMS_PER_ANALYSIS=600
KESSLER_ADMISSION_QUEUE_LIMIT=20000

KESSLER_LOG_LEVEL=INFO
